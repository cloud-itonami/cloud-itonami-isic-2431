{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). Both
 ;; live in the kotoba-lang org of this workspace. This repo is
 ;; standalone (forkable outside the workspace); the :local/root paths
 ;; only resolve inside the monorepo checkout -- a standalone fork
 ;; should override them with git coordinates. langchain is pinned here
 ;; directly (not only under :dev) so a bare `kbb -M:test` works
 ;; offline inside the monorepo checkout without depending on
 ;; langgraph's own transitive git/sha pin being fetchable.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain
        {:local/root "../../kotoba-lang/langchain"}
        io.github.kotoba-lang/robotics
        {:local/root "../../kotoba-lang/robotics"}
        ;; REAL engineering-simulation dependency (ADR-2607999800,
        ;; extending ADR-2607142800's/ADR-2607152000's/ADR-2607999600's
        ;; fleet-wide robotics-process-simulation pattern to this
        ;; vertical -- see `autoparts.robotics`/`deviceassembly.
        ;; robotics`/`steelworks.robotics` for the prior instances of
        ;; this same dependency): foundrymfg.robotics now actually
        ;; calls physics-2d/world-step -- a real, tested time-stepped
        ;; rigid-body impulse solver -- to run a real keel-block/
        ;; Y-block test-coupon tensile-test simulation (ASTM A536/
        ;; A216-style separately-cast-test-coupon practice), ADDITIONAL
        ;; to (never replacing) the existing self-reported alloy-grade/
        ;; defect-rate intake-patch checks. This vertical has no
        ;; design-library sibling repo, so the physics module is built
        ;; directly in foundrymfg.robotics and the ONLY new
        ;; dependencies are kotoba-lang/robotics (the shared mission/
        ;; action/telemetry-proof contract every cloud-itonami
        ;; vertical's robotics ns uses) and physics-2d itself, taken as
        ;; a real pinned git-coordinate dep (not :local/root) so this
        ;; repo stays forkable standalone outside the monorepo -- the
        ;; same reasoning `autoparts.robotics`/`deviceassembly.
        ;; robotics`/`steelworks.robotics` already established, using
        ;; the SAME fleet-standard SHA pin those repos currently use.
        io.github.kotoba-lang/physics-2d
        {:git/url "https://github.com/kotoba-lang/physics-2d.git"
         :sha "03b6c23c8d9aa36b92a8130fd3e37fc2548b4d26"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  ;; (kept for parity with sibling actors' deps.edn shape; redundant
  ;; with the top-level :deps override above).
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "foundrymfg.sim"]}
  ;; kbb -M:dev:render-html  -> drive the REAL actor at build time and
  ;; project the SSoT + append-only audit ledger it writes into
  ;; docs/samples/operator-console.html (a generated artifact -- regenerate,
  ;; never hand-edit). Deterministic: re-running is byte-identical.
  :render-html {:main-opts ["-m" "foundrymfg.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
